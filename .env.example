# Salin file ini jadi .env.local lalu isi nilainya. .env.local tidak pernah di-commit.

DATABASE_URL="file:./prisma/dev.db"

# Kredensial login /admin/login — dipakai saat `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-ini"

# Secret untuk menandatangani cookie session admin. Generate acak, mis:
# openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-panjang"
